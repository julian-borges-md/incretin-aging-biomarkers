.Rhistory
.RData
.Rproj.user/
renv/library/
renv/staging/
.DS_Store
work/
analysis/output/*
!analysis/output/.gitkeep
*.pdf.aux

# Exported bibliographic records: large, and licensed database content.
# The search log records the counts, strings and SHA-256 so the export is
# verifiable without redistributing Elsevier-licensed records in a public repo.
search/**/*.ris

# Per record dedup flags carry the export titles; counts live in RECALL_AND_DEDUP.md
search/**/*_dedup.csv

# Screener configuration names local models; the repository names none
search/screening/screener_config.json
search/screening/decisions_*.csv
search/screening/adjudication_*.csv
search/screening/*.log
